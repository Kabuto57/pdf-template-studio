       "field": "tolerance",
       "values": [
        "true"
       ]
      }
     ],
     "max": 2,
     "format": "number"
    }
   ]
  },
  {
   "title": "Price Basis",
   "fields": [
    {
     "id": "price_basis",
     "label": "Price basis",
     "kind": "radio",
     "options": [
      "FOB",
      "CFR",
      "CIF",
      "Local Delivery",
      "FCA",
      "CIP",
      "CPT",
      "Others"
     ],
     "required": true
    },
    {
     "id": "price_basis_other",
     "label": "Others (please specify)",
     "kind": "text",
     "half": false,
     "max": 35,
     "requiredIf": [
      {
       "field": "price_basis",
       "values": [
        "Others"
       ]
      }
     ]
    }
   ]
  },
  {
   "title": "Shipment",
   "fields": [
    {
     "id": "partial_shipment",
     "label": "Partial shipment",
     "kind": "radio",
     "options": [
      "allowed",
      "not allowed"
     ],
     "required": true,
     "half": true
    },
    {
     "id": "transhipment",
     "label": "Transhipment",
     "kind": "radio",
     "options": [
      "allowed",
      "not allowed"
     ],
     "required": true,
     "half": true
    },
    {
     "id": "shipment_from",
     "label": "Shipment from",
     "kind": "select",
     "half": true,
     "options": [
      "Port of Loading / Airport of Departure",
      "Dispatch from",
      "Place of Taking in charge",
      "Place of Receipt"
     ]
    },
    {
     "id": "shipment_from_place",
     "label": "Shipment from: place",
     "kind": "text",
     "half": true,
     "max": 35,
     "requiredIf": [
      {
       "field": "shipment_from",
       "values": [
        ""
       ],
       "not": true
      }
     ]
    },
    {
     "id": "shipment_from_place_2",
     "label": "Shipment from: place (line 2)",
     "kind": "text",
     "half": false
    },
    {
     "id": "shipment_to",
     "label": "Shipment to",
     "kind": "select",
     "half": true,
     "options": [
      "Port of Discharge / Airport of Destination",
      "For Transportation to",
      "Place of Final Destination",
      "Place of Delivery"
     ]
    },
    {
     "id": "shipment_to_place",
     "label": "Shipment to: place",
     "kind": "text",
     "half": true,
     "max": 35,
     "requiredIf": [
      {
       "field": "shipment_to",
       "values": [
        ""
       ],
       "not": true
      }
     ]
    },
    {
     "id": "shipment_to_place_2",
     "label": "Shipment to: place (line 2)",
     "kind": "text",
     "half": false
    },
    {
     "id": "latest_shipment_date",
     "label": "Latest shipment date",
     "kind": "date",
     "half": true
