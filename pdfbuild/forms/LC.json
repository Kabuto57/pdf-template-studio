{
 "title": "Irrevocable Documentary Credit Application",
 "note": "Please complete in block letters. Dates are DD/MM/YYYY.",
 "sections": [
  {
   "title": "Application",
   "fields": [
    {
     "id": "application_date",
     "label": "Date",
     "kind": "date",
     "half": true,
     "required": true
    }
   ]
  },
  {
   "title": "Mode of Advising",
   "fields": [
    {
     "id": "mode_of_advising",
     "label": "Mode of advising",
     "kind": "radio",
     "options": [
      "Full Swift",
      "Registered Airmail",
      "Airmail with Brief Swift",
      "Courier Service",
      "Courier Service with Brief Swift"
     ],
     "required": true
    }
   ]
  },
  {
   "title": "Applicant",
   "fields": [
    {
     "id": "applicant_name",
     "label": "Applicant name",
     "kind": "text",
     "half": false,
     "required": true,
     "max": 35
    },
    {
     "id": "applicant_address_1",
     "label": "Applicant address",
     "kind": "text",
     "half": false,
     "required": true,
     "max": 35
    },
    {
     "id": "applicant_address_2",
     "label": "Applicant address (line 2)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "applicant_address_3",
     "label": "Applicant address (line 3)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "applicant_address_4",
     "label": "Applicant address (line 4)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "contact_name",
     "label": "Contact party for this application & confirmation of FX rate: Name",
     "kind": "text",
     "half": false,
     "required": true,
     "max": 35
    },
    {
     "id": "contact_tel",
     "label": "Contact party: Tel no",
     "kind": "text",
     "half": true,
     "required": true,
     "max": 15,
     "format": "phone"
    },
    {
     "id": "contact_fax",
     "label": "Contact party: Fax no",
     "kind": "text",
     "half": true,
     "max": 15,
     "format": "phone"
    }
   ]
  },
  {
   "title": "For Bank Use Only",
   "bankOnly": true,
   "fields": [
    {
     "id": "dc_no",
     "label": "DC no",
     "kind": "text",
     "half": true
    },
    {
     "id": "bank_code",
     "label": "Bank code",
     "kind": "text",
     "half": true
    }
   ]
  },
  {
   "title": "Advising Bank (at Issuing Bank's option, if no nomination)",
   "fields": [
    {
     "id": "advising_bank_name",
     "label": "Name",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "advising_bank_address_1",
     "label": "Address",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "advising_bank_address_2",
     "label": "Address (line 2)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "advising_bank_address_3",
     "label": "Address (line 3)",
     "kind": "text",
     "half": false,
     "max": 35
    }
   ]
  },
  {
   "title": "For the Benefit of a 3rd Party",
   "fields": [
    {
     "id": "third_party_name",
     "label": "Name",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "third_party_address_1",
     "label": "Address",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "third_party_address_2",
     "label": "Address (line 2)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "third_party_address_3",
     "label": "Address (line 3)",
     "kind": "text",
     "half": false,
     "max": 35
    }
   ]
  },
  {
   "title": "Beneficiary",
   "fields": [
    {
     "id": "beneficiary_name",
     "label": "Beneficiary's name",
     "kind": "text",
     "half": false,
     "required": true,
     "max": 35
    },
    {
     "id": "beneficiary_address_1",
     "label": "Beneficiary's address",
     "kind": "text",
     "half": false,
     "required": true,
     "max": 35
    },
    {
     "id": "beneficiary_address_2",
     "label": "Beneficiary's address (line 2)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "beneficiary_address_3",
     "label": "Beneficiary's address (line 3)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "beneficiary_address_4",
     "label": "Beneficiary's address (line 4)",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "beneficiary_contact",
     "label": "Contact person",
     "kind": "text",
     "half": false,
     "max": 35
    },
    {
     "id": "beneficiary_tel",
     "label": "Tel no",
     "kind": "text",
     "half": true,
     "max": 15,
     "format": "phone"
    },
    {
     "id": "beneficiary_fax",
     "label": "Fax no",
     "kind": "text",
     "half": true,
     "max": 15,
     "format": "phone"
    }
   ]
  },
