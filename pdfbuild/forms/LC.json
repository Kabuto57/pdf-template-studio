   ]
  },
  {
   "title": "Expiry and Presentation",
   "fields": [
    {
     "id": "expiry_date",
     "label": "Date of expiry (in beneficiary's country)",
     "kind": "date",
     "half": true,
     "required": true
    },
    {
     "id": "presentation_days",
     "label": "Presentation period (days after shipment)",
     "kind": "text",
     "half": true,
     "format": "number"
    }
   ]
  },
  {
   "title": "Back-to-back DC",
   "fields": [
    {
     "id": "back_to_back",
     "label": "This is a back-to-back DC to be issued against the master credit (the \"Master DC\")",
     "kind": "check"
    },
    {
     "id": "master_dc_no",
     "label": "Master credit no",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "back_to_back",
       "values": [
        "true"
       ]
      }
     ],
     "max": 20
    },
    {
     "id": "master_dc_issued_by",
     "label": "Issued by",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "back_to_back",
       "values": [
        "true"
       ]
      }
     ],
     "max": 35
    }
   ]
  },
  {
   "title": "Drafts",
   "fields": [
    {
     "id": "drafts",
     "label": "Drafts for the percentage of invoice value below, at",
     "kind": "check"
    },
    {
     "id": "drafts_percent",
     "label": "Percentage of invoice value (%)",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "drafts",
       "values": [
        "true"
       ]
      }
     ],
     "format": "number",
     "max": 3
    },
    {
     "id": "drafts_at",
     "label": "Drafts at",
     "kind": "radio",
     "options": [
      "Sight",
      "Term",
      "Date"
     ],
     "requiredIf": [
      {
       "field": "drafts",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "term_days",
     "label": "Term: days",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "drafts_at",
       "values": [
        "Term"
       ]
      }
     ],
     "format": "number"
    },
    {
     "id": "term_after",
     "label": "days after",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "drafts_at",
       "values": [
        "Term"
       ]
      }
     ],
     "max": 35
    },
    {
     "id": "draft_date",
     "label": "Date",
     "kind": "date",
     "half": true,
     "requiredIf": [
      {
       "field": "drafts_at",
       "values": [
        "Date"
       ]
      }
     ]
    },
    {
     "id": "term_prepay",
     "label": "If it is a term LC, please select one",
     "kind": "radio",
     "options": [
      "You may prepay the acceptance of this term LC at the cost of beneficiary",
      "You may not prepay the acceptance of this term LC"
     ],
     "requiredIf": [
      {
       "field": "drafts_at",
       "values": [
        "Term"
       ]
      }
     ]
    }
   ]
  },
  {
   "title": "Documents Required",
   "fields": [
    {
     "id": "doc_bill_of_lading",
     "label": "Full set of Clean on Board marine bills of lading",
     "kind": "check"
    },
    {
     "id": "bl_made_out_to",
     "label": "Made out to",
     "kind": "radio",
     "options": [
      "order of the Bank",
      "order blank endorsed",
      "other (specify)"
     ],
     "requiredIf": [
      {
       "field": "doc_bill_of_lading",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "bl_made_out_to_other",
     "label": "Made out to (other)",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "bl_made_out_to",
       "values": [
        "other (specify)"
       ]
      }
     ],
     "max": 70
    },
    {
     "id": "bl_freight",
     "label": "Marked Freight",
     "kind": "radio",
     "options": [
      "Prepaid",
      "Collect"
     ],
     "half": true,
     "requiredIf": [
      {
       "field": "doc_bill_of_lading",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "bl_notify_party",
     "label": "Notify party (if not specified, notify party is considered to be applicant)",
     "kind": "text",
     "half": false,
     "max": 114,
     "requiredIf": [
      {
       "field": "doc_bill_of_lading",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "doc_air_waybill",
     "label": "Original Air Waybill consigned to the Bank",
     "kind": "check"
    },
    {
     "id": "awb_freight",
     "label": "Marked Freight",
     "kind": "radio",
     "options": [
      "Prepaid",
      "Collect"
     ],
     "half": true,
     "requiredIf": [
      {
       "field": "doc_air_waybill",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "awb_notify_party",
     "label": "Notify party (if not specified, notify party is considered to be applicant)",
     "kind": "text",
     "half": false,
     "max": 114,
     "requiredIf": [
      {
       "field": "doc_air_waybill",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "doc_delivery_order",
     "label": "Delivery order signed by beneficiary made out to applicant",
     "kind": "check"
    },
    {
     "id": "do_originals",
     "label": "Delivery order: originals",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "doc_delivery_order",
       "values": [
        "true"
       ]
      }
     ],
     "max": 2,
     "format": "number"
    },
    {
     "id": "do_copies",
     "label": "Delivery order: copies",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "doc_delivery_order",
       "values": [
        "true"
       ]
      }
     ],
     "max": 2,
     "format": "number"
    },
    {
     "id": "do_countersigned_by",
     "label": "Countersigned by how many of our signatories",
     "kind": "select",
     "half": true,
     "options": [
      "One",
      "Two"
     ],
     "requiredIf": [
      {
       "field": "doc_delivery_order",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "do_signature_verified",
     "label": "Whose signature(s) ... to be verified by the Bank",
     "kind": "select",
     "half": true,
     "options": [
      "need",
      "need not"
     ],
     "requiredIf": [
      {
       "field": "doc_delivery_order",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "doc_insurance",
     "label": "Marine/Air Insurance Policy or Certificate in duplicate, in Singapore in the currency of the credit, covering Institute Cargo Clauses (A), Institute War Clauses, Institute Strikes Clauses / Strikes, Riots and Civil Commotion",
     "kind": "check"
    },
    {
     "id": "insurance_arrangement",
     "label": "For FOB/CFR/FCA/CPT",
     "kind": "select",
     "half": false,
     "options": [
      "Insurance cover note attached",
      "Covered by ultimate buyer",
      "Please arrange insurance on our behalf",
      "Insurance covered by applicant under open Cover No."
     ],
     "activeIf": [
      {
       "field": "doc_insurance",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "insurance_cover_no",
     "label": "Open cover no",
     "kind": "text",
     "half": true,
     "max": 20,
     "requiredIf": [
      {
       "field": "insurance_arrangement",
       "values": [
        "Insurance covered by applicant under open Cover No."
       ]
      }
     ]
    },
    {
     "id": "insurance_cover_with",
     "label": "With",
     "kind": "text",
     "half": true,
     "max": 35,
     "requiredIf": [
      {
       "field": "insurance_arrangement",
       "values": [
        "Insurance covered by applicant under open Cover No."
       ]
      }
     ]
    },
    {
     "id": "doc_beneficiary_certificate",
     "label": "Beneficiary's certificate stating 1 set of non-negotiable documents has been sent to applicant",
     "kind": "check"
    },
    {
     "id": "bencert_sent_by",
     "label": "Sent by",
     "kind": "checks",
     "options": [
      "faxed",
      "mailed",
      "couriered"
     ],
     "requiredIf": [
      {
       "field": "doc_beneficiary_certificate",
       "values": [
        "true"
       ]
      }
     ]
    },
    {
     "id": "bencert_days",
     "label": "Within (days after shipment)",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "doc_beneficiary_certificate",
       "values": [
        "true"
       ]
      }
     ],
     "format": "number"
    },
    {
     "id": "doc_commercial_invoice",
     "label": "Signed commercial invoice",
     "kind": "check"
    },
    {
     "id": "invoice_originals",
     "label": "Commercial invoice: originals",
     "kind": "text",
     "half": true,
     "requiredIf": [
