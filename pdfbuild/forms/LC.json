    {
     "id": "tolerance_plus",
     "label": "Tolerance + (%)",
     "kind": "text",
     "half": true,
     "requiredIf": [
      {
       "field": "tolerance",
       "values": [
        "true"
       ]
      }
     ],
     "max": 2,
     "format": "number"
    },
    {
     "id": "tolerance_minus",
     "label": "Tolerance - (%)",
     "kind": "text",
