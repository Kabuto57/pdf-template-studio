{
  "name": "pdf-template-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design a fillable PDF form, fill it, and extract its answers as JSON. Runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "pdfs": "vitest run scripts/lc-pdfs",
    "make-script": "rolldown scripts/make-lc-pdf.ts --format esm --platform node --minify --file public/make-lc-pdf.txt",
    "spec": "vitest run scripts/lc-spec",
    "prebuild": "node -e \"require('fs').cpSync('node_modules/pdfjs-dist/standard_fonts','public/standard_fonts',{recursive:true})\"",
    "predev": "node -e \"require('fs').cpSync('node_modules/pdfjs-dist/standard_fonts','public/standard_fonts',{recursive:true})\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
